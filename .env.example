# Reference values only: Spring Boot reads process environment, not this file.
# Spring Boot product backend (apps/backend).
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/expense_tracker_java
SPRING_DATASOURCE_USERNAME=expense_tracker
SPRING_DATASOURCE_PASSWORD=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Keep true for HTTPS; false is only for local HTTP development.
SESSION_COOKIE_SECURE=true
# Optional Docker Compose PostgreSQL host port; defaults to 5433.
BACKEND_POSTGRES_PORT=5433

# Integration tests use Testcontainers by default. Without Docker, set all three
# against a disposable PostgreSQL test database; each run creates a new schema.
# TEST_DATABASE_URL=jdbc:postgresql://127.0.0.1:55433/expense_tracker_test
# TEST_DATABASE_USERNAME=expense_tracker_test
# TEST_DATABASE_PASSWORD=
