# Reference values only: Django reads process environment, not this file.
# Local SQLite works without setting any variables.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required when DJANGO_DEBUG=false. Generate a unique secret for deployment.
DJANGO_SECRET_KEY=

# Optional PostgreSQL configuration; leave POSTGRES_DB unset to use SQLite.
POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_tracker
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Alternative: DATABASE_URL=postgresql://user:password@host:5432/database
