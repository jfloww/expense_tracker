# Reference values only: applications read process environment, not this file.
# Spring Boot product backend (apps/backend). Use a separate database from Django.
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/expense_tracker_java
SPRING_DATASOURCE_USERNAME=expense_tracker
SPRING_DATASOURCE_PASSWORD=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# Keep true for HTTPS; false is only for local HTTP development.
SESSION_COOKIE_SECURE=true
# Optional Docker Compose PostgreSQL host port; defaults to 5433.
BACKEND_POSTGRES_PORT=5433

# Integration tests use Testcontainers by default. Without Docker, set all three
# against a disposable PostgreSQL test database; each run creates a new schema.
# TEST_DATABASE_URL=jdbc:postgresql://127.0.0.1:55433/expense_tracker_test
# TEST_DATABASE_USERNAME=expense_tracker_test
# TEST_DATABASE_PASSWORD=

# Legacy Django reference (apps/api).
# Local SQLite works without setting any variables.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Required when DJANGO_DEBUG=false. Generate a unique secret for deployment.
DJANGO_SECRET_KEY=

# Optional PostgreSQL configuration; leave POSTGRES_DB unset to use SQLite.
POSTGRES_DB=expense_tracker
POSTGRES_USER=expense_tracker
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Alternative: DATABASE_URL=postgresql://user:password@host:5432/database
